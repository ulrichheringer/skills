{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "awk 'c==2;/^---$/{c++}' \"${CLAUDE_PLUGIN_ROOT}/skills/terse/SKILL.md\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'TERSE MODE MANDATORY. Fragments only. No preamble, filler, articles, or recap. Max ~15 lines. Code, commits, PRs, security: write normal.'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/no-bash-edits.mjs\""
          }
        ]
      }
    ]
  }
}

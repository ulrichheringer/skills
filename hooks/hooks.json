{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "awk 'c==2;/^---$/{c++}' \"${CLAUDE_PLUGIN_ROOT}/skills/terse/SKILL.md\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'TERSE MODE ACTIVE. Shortest complete answer, no filler, no recap. Code, commits, PRs, security: write normal.'"
          }
        ]
      }
    ]
  }
}
